# ==============================================================================
# ApplyPilot Secrets & Integrations Environment Variables
# ==============================================================================

# LLM API Keys (At least one required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Universal Applicant Tracking System (ATS) Credentials
WORKDAY_PASSWORD=YourUniversalWorkdayPassword123!
GREENHOUSE_PASSWORD=YourUniversalGreenhousePassword123!

# Automation Settings
HEADLESS=true
DELAY_BETWEEN_APPS=5

# ------------------------------------------------------------------------------
# Optional: Workday Email OTP Listener (Auto-fetch 6-digit verification codes)
# ------------------------------------------------------------------------------
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords)
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_APP_PASSWORD=your_16char_gmail_app_password

# ------------------------------------------------------------------------------
# Optional: Self-Hosted Vaultwarden / Bitwarden Auto-Sync
# ------------------------------------------------------------------------------
VAULTWARDEN_URL=https://vault.somethingsomething.fyi
VAULTWARDEN_EMAIL=your.email@example.com
