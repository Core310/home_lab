# ==============================================================================
# ApplyPilot Secrets & Environment Variables
# ==============================================================================

# LLM API Keys (At least one required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Universal Applicant Tracking System (ATS) Credentials
WORKDAY_PASSWORD=YourSecureWorkdayPassword123!
GREENHOUSE_PASSWORD=YourSecureGreenhousePassword123!

# Automation Settings
HEADLESS=true
DELAY_BETWEEN_APPS=5
