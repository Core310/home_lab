{
    email {$ACME_EMAIL:admin@somethingsomething.fyi}
}

(cf_tls) {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1 8.8.8.8
    }
}

# Dashboard & Identity
dash.{$DOMAIN:somethingsomething.fyi} {
    import cf_tls
    reverse_proxy host.docker.internal:9302
}

auth.{$DOMAIN:somethingsomething.fyi} {
    import cf_tls
    reverse_proxy host.docker.internal:9300
}

# Personal Cloud & Vault
vault.{$DOMAIN:somethingsomething.fyi} {
    import cf_tls
    reverse_proxy host.docker.internal:9400
}

photos.{$DOMAIN:somethingsomething.fyi} {
    import cf_tls
    reverse_proxy host.docker.internal:9401 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}

